<Window x:Class="DocTranslate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DocTranslate — Word, PDF &amp; PowerPoint Translator"
        Height="700" Width="860" MinHeight="600" MinWidth="720"
        WindowStartupLocation="Manual" Left="300" Top="150"
        Background="#0F1117" Foreground="#E8EAF6" FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background"      Value="#6C63FF"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="16,8"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#5A52E0"/></Trigger>
                            <Trigger Property="IsEnabled"   Value="False"><Setter Property="Opacity"    Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GreenBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#43D9AD"/>
            <Setter Property="Foreground" Value="#0A1A14"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#35B891"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="GhostBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#22263A"/>
            <Setter Property="Foreground" Value="#7B80A0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#2E3250"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background"      Value="#22263A"/>
            <Setter Property="Foreground"      Value="#E8EAF6"/>
            <Setter Property="BorderBrush"     Value="#2E3250"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="10,6"/>
            <Setter Property="FontSize"        Value="12"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1A1D27">
            <Grid Margin="24,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📄  DocTranslate" FontSize="22" FontWeight="Bold"
                               Foreground="#E8EAF6" VerticalAlignment="Center"/>
                    <TextBlock Text="  Word, PDF &amp; PowerPoint Translator" FontSize="12"
                               Foreground="#7B80A0" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="WordBadge" Text="● Word COM" FontSize="11"
                               Foreground="#43D9AD" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <TextBlock x:Name="PptBadge" Text="● PowerPoint COM" FontSize="11"
                               Foreground="#43D9AD" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button Content="Manage Models" Style="{StaticResource GhostBtn}"
                            Height="32" Click="OnManageModels"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Banner -->
        <Border Grid.Row="1" x:Name="BannerBorder" Background="#22263A">
            <TextBlock x:Name="BannerText" Text="Starting translation engine…"
                       FontSize="11" Foreground="#7B80A0"
                       VerticalAlignment="Center" Margin="16,0"/>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="2" Margin="24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Step 1 -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="1  Choose a document (.docx, .pdf or .pptx)" FontSize="12"
                           FontWeight="SemiBold" Foreground="#7B80A0" Margin="0,0,0,4"/>
                <Border Height="1" Background="#2E3250" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#22263A" CornerRadius="8"
                            Padding="14,10" Margin="0,0,10,0">
                        <TextBlock x:Name="FileLabel" Text="No file selected"
                                   Foreground="#7B80A0" FontSize="13" TextTrimming="CharacterEllipsis"/>
                    </Border>
                    <Button Grid.Column="1" Content="Browse…" Style="{StaticResource PrimaryBtn}"
                            Width="100" Height="40" Click="OnBrowse"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Border x:Name="TypeBadge" CornerRadius="4" Padding="8,3" Visibility="Collapsed">
                        <TextBlock x:Name="TypeBadgeText" FontSize="11" FontWeight="Bold"/>
                    </Border>
                    <TextBlock x:Name="FileInfo" Text="" FontSize="11"
                               Foreground="#43D9AD" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Step 2 -->
            <StackPanel Grid.Row="1" Margin="0,18,0,0">
                <TextBlock Text="2  Choose source &amp; target language" FontSize="12"
                           FontWeight="SemiBold" Foreground="#7B80A0" Margin="0,0,0,4"/>
                <Border Height="1" Background="#2E3250" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="From:" Foreground="#7B80A0" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="SrcLangBox" Width="230" Height="38"/>
                    <TextBlock Text="  →  To:" Foreground="#7B80A0" FontSize="12"
                               VerticalAlignment="Center" Margin="12,0,8,0"/>
                    <ComboBox x:Name="TgtLangBox" Width="230" Height="38"/>
                </StackPanel>
                <TextBlock x:Name="ModelStatus" Text="" FontSize="11"
                           Foreground="#7B80A0" Margin="0,6,0,0"/>
            </StackPanel>

            <!-- Step 3 -->
            <StackPanel Grid.Row="2" Margin="0,18,0,0">
                <TextBlock Text="3  Translate" FontSize="12" FontWeight="SemiBold"
                           Foreground="#7B80A0" Margin="0,0,0,4"/>
                <Border Height="1" Background="#2E3250" Margin="0,0,0,8"/>
                <Button x:Name="TranslateBtn" Content="✦  Translate Document"
                        Style="{StaticResource PrimaryBtn}"
                        Height="50" FontSize="15" FontWeight="Bold" Click="OnTranslate"/>
            </StackPanel>

            <!-- Progress -->
            <StackPanel Grid.Row="3" Margin="0,12,0,0">
                <ProgressBar x:Name="ProgressBar" Height="6"
                             Background="#22263A" Foreground="#6C63FF"
                             BorderThickness="0" Value="0" Maximum="100"/>
                <TextBlock x:Name="StatusText" Text="Select a .docx, .pdf or .pptx file to get started."
                           FontSize="12" Foreground="#7B80A0" Margin="0,6,0,0"/>
            </StackPanel>

            <!-- Step 4 -->
            <StackPanel Grid.Row="4" Margin="0,18,0,0">
                <TextBlock Text="4  Save translated document" FontSize="12"
                           FontWeight="SemiBold" Foreground="#7B80A0" Margin="0,0,0,4"/>
                <Border Height="1" Background="#2E3250" Margin="0,0,0,8"/>
                <Button x:Name="SaveBtn" Content="⬇  Save Translated Document"
                        Style="{StaticResource GreenBtn}"
                        Height="48" FontSize="14" FontWeight="Bold"
                        IsEnabled="False" Click="OnSave"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
